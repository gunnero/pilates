#!/usr/bin/env python3
"""Bounded tracked-source secret checks; complements dependency audits, not a full DLP tool."""
from pathlib import Path
import re
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
paths = subprocess.check_output(['git', 'ls-files', '-z', '--cached', '--others', '--exclude-standard'], cwd=root).decode().split('\0')
patterns = [
    re.compile(rb'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----'),
    re.compile(rb'\b(?:ghp_|github_pat_)[A-Za-z0-9_]{30,}\b'),
    re.compile(rb'\bAKIA[A-Z0-9]{16}\b'),
    re.compile(rb'(?m)^APP_KEY=base64:[A-Za-z0-9+/]{40,}={0,2}\s*$'),
    re.compile(rb'(?m)^(?:DB_PASSWORD|REDIS_PASSWORD|MAIL_PASSWORD)=(?!\s*$|null\s*$)[^\n]+$'),
]
failures = []
for name in sorted(set(paths) - {''}):
    path = root / name
    if not path.is_file():
        continue
    if (path.name == '.env' or path.name.startswith('.env.')) and path.name != '.env.example':
        failures.append(name + ': environment file must not be tracked')
    if name.split('/')[0] in ('vendor', 'node_modules', '.local') or name.startswith('public/build/'):
        failures.append(name + ': generated/private artifact')
    data = path.read_bytes()
    if any(pattern.search(data) for pattern in patterns):
        failures.append(name + ': potential secret (value redacted)')
if failures:
    print('\n'.join(failures))
    sys.exit(1)
print(f'Secret/artifact checks passed for {len(set(paths) - {""})} source files.')
