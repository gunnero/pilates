#!/usr/bin/env python3
"""Create only disposable hosted-test configuration, never read local secrets."""
import base64
import os
from pathlib import Path
import secrets

if os.environ.get('GITHUB_ACTIONS') != 'true':
    raise SystemExit('This helper is restricted to disposable GitHub runners.')
os.umask(0o077)
values = {
    'APP_ENV': 'testing',
    'APP_KEY': 'base64:' + base64.b64encode(secrets.token_bytes(32)).decode(),
    'DB_HOST': '127.0.0.1', 'DB_PORT': '5432', 'DB_DATABASE': 'gt_test',
    'DB_USERNAME': 'gt_test', 'DB_PASSWORD': 'ci-only-postgres',
    'CACHE_STORE': 'array', 'SESSION_DRIVER': 'array', 'MAIL_MAILER': 'array',
    'NOTIFICATION_PUSH_ENABLED': 'false', 'NOTIFICATION_EMAIL_ENABLED': 'false',
}
lines = []
for line in Path('.env.example').read_text().splitlines():
    key = line.split('=', 1)[0]
    lines.append(key + '=' + values.pop(key) if key in values else line)
lines.extend(key + '=' + value for key, value in values.items())
Path('.env.testing').write_text('\n'.join(lines) + '\n')
