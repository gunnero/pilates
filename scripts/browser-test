#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ -d "$PWD/.local/browser-libs/usr/lib/x86_64-linux-gnu" ]]; then
    export LD_LIBRARY_PATH="$PWD/.local/browser-libs/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
# Each batch owns a fresh gt_test fixture/cache lifecycle. Real production login
# limits still apply: unrelated flows must not exhaust the same loopback IP bucket.
if [[ $# -eq 0 ]]; then
    prior_flows=()
    for flow in tests/browser/*.spec.ts; do
        [[ -f "$flow" && "$flow" != tests/browser/reports.spec.ts ]] && prior_flows+=("$flow")
    done
    [[ ${#prior_flows[@]} -gt 0 && -f tests/browser/reports.spec.ts ]]
    status=0
    for viewport in desktop mobile; do
        pnpm exec playwright test "${prior_flows[@]}" --project="$viewport" || status=1
        pnpm exec playwright test tests/browser/reports.spec.ts --project="$viewport" || status=1
    done
    exit "$status"
fi
exec pnpm exec playwright test "$@"
