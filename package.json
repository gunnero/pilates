{
    "name": "gt-studio",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.3.4",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:e2e": "scripts/browser-test",
        "mobile:check": "pnpm --dir apps/mobile typecheck && pnpm --dir apps/mobile test && pnpm --dir apps/mobile run doctor && pnpm --dir apps/mobile bundle"
    },
    "dependencies": {
        "i18next": "^26.4.2",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.14",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.13.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "jsdom": "^30.1.0",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
