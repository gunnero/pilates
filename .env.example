APP_NAME="GT"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8010
APP_LOCALE=mk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
STUDIO_TIMEZONE=Europe/Skopje
STUDIO_CURRENCY=MKD
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=gt_dev
DB_USERNAME=gt_dev
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Only local HTTP uses false. Production forces secure cookies.
SESSION_SECURE_COOKIE=false
SESSION_COOKIE=gt_session
SESSION_DOMAIN=null
CACHE_STORE=redis
CACHE_PREFIX=gt_cache_
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=gt_redis_
# No outgoing mail or token-bearing mail logs in local development.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="GT"
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8010,localhost:8010
VITE_APP_NAME="GT"
